[submodule "colcon_ws/src/open_vins"]
    path   = colcon_ws/src/open_vins
    url    = https://github.com/alessandrocurci2002/OpenVins_StereocameraPX4.git
    branch = master

[submodule "OAK-ROS-depthai"]
    path   = depthai-ws/src/depthai-ros
    url    = https://github.com/alessandrocurci2002/depthai-ros.git
    branch = v3_humble

[submodule "depthai-core"]
    path   = depthai-ws/src/depthai-core
    url    = https://github.com/luxonis/depthai-core.git
    branch = main
[submodule "px4-ws/PX4-Autopilot"]
	path = px4-ws/PX4-Autopilot
	url = https://github.com/FedericoDD/PX4-Autopilot.git
	branch = PX4-Autopilot/v1.17.0
	update = none
